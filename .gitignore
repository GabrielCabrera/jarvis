# ==============================================================================
# Jarvis Control Plane - Defense-in-Depth Git Ignore
# ==============================================================================

# OS & Workspace Artifacts
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.antigravity-ide/

# Ephemeral & Logs
tmp/
*.log
*.tar.gz
*.zip

# Secrets & Environment variables
.env
.env.*
!.env.example
*.local

# Shell History & Credentials
.zsh_history
.bash_history
.zsh_secrets

# SSH Keys and Strict Allowlist Protection
dotfiles/ssh/.ssh/keys/
dotfiles/ssh/.ssh/deprecated_keys/
dotfiles/ssh/.ssh/known_hosts*
dotfiles/ssh/.ssh/id_*
dotfiles/ssh/.ssh/*_ed25519*
dotfiles/ssh/.ssh/*_key*
*.pem
*.key
*sealed*.yaml

# Local application state (should never be versioned in dotfiles)
dotfiles/config/.config/1Password/
dotfiles/config/.config/op/
dotfiles/config/.config/wireshark/
dotfiles/config/.config/gh/hosts.yml

# Gemini & Antigravity local state / secrets protection
dotfiles/gemini/.gemini/antigravity/brain/
dotfiles/gemini/.gemini/antigravity-cli/brain/
dotfiles/gemini/.gemini/antigravity-cli/conversations/
dotfiles/gemini/.gemini/antigravity-cli/history.jsonl
dotfiles/gemini/.gemini/antigravity-cli/log/
dotfiles/gemini/.gemini/antigravity-cli/cache/
dotfiles/gemini/.gemini/antigravity-cli/crashes/
*credentials*
*token*
*auth*
