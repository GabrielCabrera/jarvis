# ==============================================================================
# GHOSTTY ARCHITECTURE CONFIGURATION
# ==============================================================================

# --- 1. APARIENCIA & DISEÑO (VISTA PREMIUM) ---
theme = "Atom One Dark"
window-theme = dark

# Transparencia y desenfoque (Glassmorphism)
background-opacity = 0.98
background-blur = true

# Integración con macOS
macos-titlebar-style = "transparent"
macos-titlebar-proxy-icon = "hidden"
macos-non-native-fullscreen = false

# Margen interno simétrico (Padding)
window-padding-x = 12
window-padding-y = 12

# --- 2. FUENTE & RENDERIZADO ---
font-family = "JetBrainsMono Nerd Font"
font-style = "Regular"
font-size = 16

# Renderizado suave para pantallas Liquid Retina XDR (120Hz ProMotion)
adjust-cursor-thickness = 0.15%

# Estilo de Cursor alineado a terminales modernas
cursor-style = "block"
cursor-style-blink = true

# --- 3. COMPORTAMIENTO & INTERACCIÓN ---
copy-on-select = clipboard
desktop-notifications = true
mouse-hide-while-typing = true
confirm-close-surface = false

# --- 4. CONTROL DE BÚFER ---
# Alineado a los 100K de retención de historial en ~/.zshrc
scrollback-limit = 100000

# --- 5. ACTUALIZACIONES ---
auto-update = download
auto-update-channel = stable